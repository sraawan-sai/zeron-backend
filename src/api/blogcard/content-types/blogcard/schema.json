      "target": "api::category.category",
      "inversedBy": "blogcards"
    },
    "excerpt": {
      "type": "text"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "slug": {
      "type": "uid"
    },
    "isPopular": {
      "type": "boolean",
      "default": false
